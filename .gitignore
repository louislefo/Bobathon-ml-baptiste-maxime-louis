# secrets and skore-cli credentials
.env
.skore

# virtual environment created in the install steps
.venv/

# skills are installed per machine — do not vendor them
.bob/*
# ...but the workspace rules do ship with the repo
!.bob/rules/

# agent scratch probes
scratch/

# Kaggle submission files (regenerated by the experiment scripts;
# the leaderboard, not git, is the record)
submissions/

# Competition data: download it from the Kaggle Data tab into data/
# (competition rules forbid republishing it)
data/*.csv

# Docusaurus static build (rebuilt by the GitHub Pages workflow)
site/

# Bob is the only coding agent: no other agent config folders
.agents/
.pi/

# bytecode
__pycache__/
*.pyc

# nested clone of https://github.com/probabl-ai/skills-hackathon
skills/

# OS / IDE
.DS_Store

# local git worktrees
.worktrees/

# Docusaurus build caches
website/node_modules/
website/.docusaurus/
website/build/
